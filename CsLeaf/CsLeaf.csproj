<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
  <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <!-- The C# port is a SIBLING of this repository, so the default
         reference is RELATIVE to this project directory:
             gitpp-cross-port/CsLeaf/../../gitpp-cs/src/Gitpp.csproj

         The default used to be the absolute path
             /tmp/gitpp-cs/src/Gitpp.csproj
         which exists on exactly one machine. In CI the port is cloned
         next to this repo, so the reference did not resolve and the
         build died with

             Skipping project "/tmp/gitpp-cs/src/Gitpp.csproj"
                                because it was not found.
             error CS0246: The type or namespace name 'Gitpp' could
                          not be found

         A hardcoded absolute path in a build file is a build file
         that only works where it was written. The property is still
         overridable, and the callers now override it anyway.
    -->
    <GitppCsProj Condition="'$(GitppCsProj)'==''">$(MSBuildThisFileDirectory)../../gitpp-cs/src/Gitpp.csproj</GitppCsProj>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="$(GitppCsProj)" /></ItemGroup>
</Project>

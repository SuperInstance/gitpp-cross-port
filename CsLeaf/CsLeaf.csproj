<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
  <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <!-- The gitpp-cs checkout, resolved at build time rather than
         hardcoded. /tmp/gitpp-cs exists on exactly one machine, so this
         project only built there, and the failure surfaced as "the cs
         participant could not load" rather than as a build error.
         GitppCsProj overrides it; GITPP_CS_DIR is the environment
         friendly form. Note: an XML comment may not contain a double
         hyphen, which is a tedious way to lose an afternoon. -->
    <GitppCsProj Condition="'$(GitppCsProj)'=='' AND '$(GITPP_CS_DIR)'!=''">$(GITPP_CS_DIR)/src/Gitpp.csproj</GitppCsProj>
    <GitppCsProj Condition="'$(GitppCsProj)'=='' AND Exists('$(MSBuildThisFileDirectory)../../gitpp-cs/src/Gitpp.csproj')">$(MSBuildThisFileDirectory)../../gitpp-cs/src/Gitpp.csproj</GitppCsProj>
    <!-- The LAST tier is the RELATIVE path, unconditionally. It used to
         be the absolute /tmp/gitpp-cs path, and that is the shape of
         defect this whole session has been about: a hardcoded absolute
         path in a build file is a build file that only works where it
         was written, and a silent fallback to it turns "the port is
         not here" into a confusing error about a project that does not
         exist.

         Naming the relative path in the last tier means the failure
         message points at where the port WAS SUPPOSED TO BE. The
         one-machine legacy layout is still available: set
         GITPP_CS_DIR, or pass -p:GitppCsProj=... -->
    <GitppCsProj Condition="'$(GitppCsProj)'==''">$(MSBuildThisFileDirectory)../../gitpp-cs/src/Gitpp.csproj</GitppCsProj>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="$(GitppCsProj)" /></ItemGroup>
</Project>
